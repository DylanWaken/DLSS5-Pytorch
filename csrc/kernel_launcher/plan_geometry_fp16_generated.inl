static const FGeometryPlanSpec& SelectGeometryPlan(int64_t Width, int64_t Height)
{
	for (const auto& Geometry : GeometryPlans)
	{
		if (Geometry.ValidWidth == Width && Geometry.ValidHeight == Height)
